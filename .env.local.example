# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# DeepSeek — used for text/email receipt parsing (cheap)
# Get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Google Gemini — used for receipt photo + PDF parsing (vision)
# Free tier at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud Vision OCR — optional OCR pre-pass for receipt photos/screenshots.
# Enable the API at https://console.cloud.google.com/apis/library/vision.googleapis.com
# then create an API key and paste it here.
GOOGLE_CLOUD_VISION_API_KEY=

# Cerebras — free daily text parsing before Gemini.
# Get one at https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_TEXT_MODEL=gpt-oss-120b

# Groq — free daily text parsing and optional receipt image parsing before Gemini.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_TEXT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# USDA FoodData Central — nutrition lookup (free)
# Sign up at https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=

# Open Food Facts — optional read-only packaged food lookup.
# Read requests do not need an API key, but Open Food Facts asks every app to
# send a custom User-Agent. Include an email/contact if you deploy publicly.
OPEN_FOOD_FACTS_USER_AGENT="FoodTracker/0.1 (you@example.com)"
# Optional safety valve for name-search calls per receipt enrichment.
OPEN_FOOD_FACTS_SEARCH_LIMIT_PER_RECEIPT=8

# Turso/libSQL — used for all persistence, both local dev and production.
# Create a database at https://turso.tech, then set:
#   TURSO_DATABASE_URL=libsql://food-tracker-xxxx.turso.io
#   TURSO_AUTH_TOKEN=<token from `turso db tokens create food-tracker`>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# One-time migration only: source Neon Postgres URL. You can also leave the old
# value in DATABASE_URL and the migration script will use it as the source.
NEON_DATABASE_URL=
DATABASE_URL=

# Used to encrypt email App Passwords stored in the settings table.
# Generate with: setkey EMAIL_ENCRYPTION_KEY  (and type 'g' at the prompt)
EMAIL_ENCRYPTION_KEY=

# Google OAuth — used to connect Gmail read-only inbox access and Google Photos Picker.
# In Google Cloud Console, enable the Gmail API and Google Photos Picker API,
# then create an OAuth Web client.
# Authorized redirect URI for local dev:
#   http://localhost:3000/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional override; otherwise the app derives this from the current origin.
GOOGLE_REDIRECT_URI=
# Optional Gmail search query for inbox receipt import.
GMAIL_RECEIPT_QUERY="newer_than:90d (receipt OR order OR invoice)"

# AI Free local gateway — optional OpenAI-compatible fallback if you run a local
# gateway that fans out to free providers. Leave blank unless it is running.
AI_FREE_BASE_URL=
AI_FREE_API_KEY=local-dev
AI_FREE_TEXT_MODEL=gpt-oss-120b
AI_FREE_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
